{
  "name": "threadlabs",
  "version": "0.1.0",
  "description": "An executable, evidence-based standard for open-source repositories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/foundation.git"
  },
  "homepage": "https://github.com/threadlabs-studio/foundation#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/foundation/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "threadlabs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "templates"
  ],
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run --exclude tests/contract/package.test.ts",
    "test:contracts": "vitest run tests/contract --exclude tests/contract/package.test.ts",
    "test:package": "vitest run tests/contract/package.test.ts",
    "test:dogfood": "vitest run tests/integration/dogfood.test.ts",
    "test:public": "vitest run tests/contract/public-safety.test.ts",
    "test:cross-platform": "vitest run tests/integration/apply-resume.test.ts tests/integration/cli.test.ts",
    "verify:inner": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:pr": "pnpm verify:inner && pnpm test:package",
    "verify:extended": "pnpm verify:pr && pnpm test:cross-platform",
    "verify:release": "pnpm verify:pr && pnpm threadlabs release . --json",
    "prepack": "pnpm build",
    "prepare": "pnpm build",
    "prethreadlabs": "pnpm build",
    "threadlabs": "node ./dist/cli.js"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/semver": "7.8.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}

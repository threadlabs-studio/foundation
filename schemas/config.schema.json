{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadlabs.dev/schemas/config.schema.json",
  "title": "Threadlabs configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standardVersion", "bundles", "modules", "exceptions", "ownership"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "standardVersion": { "type": "string", "minLength": 1 },
    "bundles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "modules": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlId", "reason", "owner", "scope", "reviewDate"],
        "properties": {
          "controlId": { "$ref": "#/$defs/id" },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "reviewDate": { "type": "string", "format": "date" }
        }
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "mode": {
            "enum": ["managed", "section-managed", "local", "unmanaged", "ambiguous"]
          },
          "anchors": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "type": "string", "minLength": 3 },
              { "type": "string", "minLength": 3 }
            ]
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holds"],
      "properties": {
        "holds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "reason", "owner", "reviewDate"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "reviewDate": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "enum": [
            "single-package",
            "fixed-monorepo",
            "independent-monorepo",
            "prerelease-channel",
            "exceptional-multi-artifact"
          ]
        }
      }
    },
    "settings": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*\\\\).+$"
    }
  }
}
